# OpenShift NVCF secrets template
# Copy this file to ocp-nvcf-secrets.yaml and replace placeholder values
# with your actual credentials.
#
# Two registries are used:
# - quay.io: infrastructure images (NVCF services), pulled via K8s imagePullSecrets
# - nvcr.io: function container images (inference workloads), registered via NVCF API
#
# To generate base64 credentials:
#   NGC:     printf '%s' '$oauthtoken:<NGC_API_KEY>' | base64 | tr -d '\n'
#   quay.io: printf '%s' 'username:password' | base64 | tr -d '\n'

openbao:
  migrations:
    env:
      - name: DEFAULT_CASSANDRA_PASSWORD
        value: "REPLACE_WITH_CASSANDRA_PASSWORD"
      - name: NVCF_API_SIDECARS_IMAGE_PULL_SECRET
        value: REPLACE_WITH_BASE64_QUAY_CREDENTIAL
      - name: ADMIN_CLIENT_ID
        value: ncp

api:
  accountBootstrap:
    # Function container registry credentials (registered in NVCF API).
    # Must use a recognized registry: NGC, ECR, ACR, VolcEngine, JFrog, or Harbor.
    # quay.io is NOT recognized by the NVCF API (see deployment log, step 1).
    registryCredentials:
      - registryHostname: nvcr.io
        secret:
          name: nvcr-containers
          value: REPLACE_WITH_BASE64_NGC_CREDENTIAL
        artifactTypes: ["CONTAINER"]
        tags: []
        description: "NGC Container registry"
      - registryHostname: helm.ngc.nvidia.com
        secret:
          name: nvcr-helmcharts
          value: REPLACE_WITH_BASE64_NGC_CREDENTIAL
        artifactTypes: ["HELM"]
        tags: []
        description: "NGC Helm registry"
